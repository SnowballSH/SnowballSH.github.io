---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import type { CollectionEntry } from "astro:content";

export const getStaticPaths: GetStaticPaths = async () => {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
};

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props as Props;
const { Content } = await project.render();
const {
  title,
  shortDescription,
  date,
  technologies,
  image,
  imageAlt,
  githubUrl,
  liveUrl,
  demoUrl,
  links,
  status,
  category,
} = project.data;

const formattedDate = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(date);

const statusStyles = {
  completed: "bg-green-500/20 text-green-300 border-green-500/30",
  "in-progress": "bg-yellow-500/20 text-yellow-300 border-yellow-500/30",
  planned: "bg-blue-500/20 text-blue-300 border-blue-500/30",
};

const site = Astro.site ?? new URL("https://snowballsh.github.io");
const canonicalUrl = new URL(Astro.url.pathname, site).toString();
const publishedIso = date.toISOString();
const projectSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: title,
  description: shortDescription,
  url: canonicalUrl,
  codeRepository: githubUrl,
  datePublished: publishedIso,
  dateModified: publishedIso,
  programmingLanguage: technologies,
  author: {
    "@type": "Person",
    name: "Yinuo Huang",
    alternateName: "SnowballSH",
    url: new URL("/", site).toString(),
  },
  image: new URL(image || "/favicon.webp", site).toString(),
  keywords: [category, ...technologies],
};
---

<Layout
  title={`${title} - SnowballSH (Yinuo Huang)`}
  description={shortDescription}
  type="article"
  image={image || "/favicon.webp"}
  publishedTime={publishedIso}
  modifiedTime={publishedIso}
  keywords={["SnowballSH", "Yinuo Huang", "project", category, ...technologies]}
  schema={projectSchema}
>
  <div class="futuristic-bg"></div>
  <div class="geometric-overlay"></div>

  <div class="pointer-events-none fixed inset-0 z-0 overflow-hidden">
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
  </div>

  <main class="relative z-10 min-h-screen">
    <div class="container mx-auto px-6 pt-28 md:pt-32">
      <a
        href="/projects"
        class="text-primary-400 hover:text-primary-300 mb-8 inline-flex items-center transition-colors"
      >
        ← Back to Projects
      </a>
    </div>

    <section class="py-12">
      <div class="container mx-auto px-6">
        <div class="mx-auto max-w-4xl">
          <div class="mb-6 flex flex-wrap items-center gap-4">
            <span class="text-gray-300">{formattedDate}</span>
            <span class="text-gray-500">•</span>
            <span class="text-gray-300 capitalize">{category}</span>
            {
              status !== "completed" && (
                <>
                  <span class="text-gray-500">•</span>
                  <div
                    class={`inline-flex items-center rounded-full border px-3 py-1 text-sm font-medium ${statusStyles[status as keyof typeof statusStyles]}`}
                  >
                    {status === "in-progress" ? "In Progress" : "Planned"}
                  </div>
                </>
              )
            }
          </div>

          <h1
            class="section-heading mb-6 text-5xl font-bold text-white md:text-6xl"
          >
            {title}
          </h1>

          <p class="section-lead mb-8 text-lg md:text-xl">
            {shortDescription}
          </p>

          <div class="mb-8 flex flex-wrap gap-3">
            {
              technologies.map((tech: string) => (
                <span class="bg-primary-500/20 text-primary-300 rounded-full px-4 py-2 font-medium">
                  {tech}
                </span>
              ))
            }
          </div>

          <div class="mb-12 flex flex-wrap gap-4">
            {
              liveUrl && (
                <a
                  href={liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="glass-button px-6 py-3 font-semibold"
                >
                  View Live Site
                </a>
              )
            }

            {
              demoUrl && (
                <a
                  href={demoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="glass-button px-6 py-3 font-semibold"
                >
                  Try Demo
                </a>
              )
            }

            {
              githubUrl && (
                <a
                  href={githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="glass-button px-6 py-3 font-semibold"
                >
                  View Source
                </a>
              )
            }

            {
              links &&
                links.map((link: any) => (
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="glass-button px-6 py-3 font-semibold"
                  >
                    {link.label}
                  </a>
                ))
            }
          </div>
        </div>
      </div>
    </section>

    {
      image && (
        <section class="py-8">
          <div class="container mx-auto px-6">
            <div class="mx-auto max-w-4xl">
              <div class="glass-panel p-4">
                <img
                  src={image}
                  alt={imageAlt || `Screenshot of ${title}`}
                  width="800"
                  height="480"
                  class="h-80 w-full rounded-lg object-contain"
                  loading="eager"
                />
              </div>
            </div>
          </div>
        </section>
      )
    }

    <section class="py-12">
      <div class="container mx-auto px-6">
        <div class="mx-auto max-w-4xl">
          <article class="glass-panel prose-content" style="padding: 3rem;">
            <div class="markdown-content">
              <Content />
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="py-20">
      <div class="container mx-auto px-6">
        <h2
          class="section-heading mb-12 text-center text-3xl font-bold text-white"
        >
          Other Projects
        </h2>
        <div class="text-center">
          <a
            href="/projects"
            class="glass-button px-8 py-4 text-lg font-semibold"
          >
            View All Projects
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .prose-content {
    max-width: none !important;
  }

  .glass-panel .prose-content h1,
  .prose-content h1 {
    font-size: 2.25rem !important;
    font-weight: 700 !important;
    color: #ffffff !important;
    margin-bottom: 1.5rem !important;
    margin-top: 2rem !important;
    line-height: 1.2 !important;
    font-family:
      "Poppins",
      -apple-system,
      BlinkMacSystemFont,
      "PingFang SC",
      "Microsoft YaHei",
      "Noto Sans CJK SC",
      "Source Han Sans SC",
      system-ui,
      sans-serif !important;
    display: block !important;
  }

  .glass-panel .prose-content h1:first-child,
  .prose-content h1:first-child {
    margin-top: 0 !important;
  }

  .glass-panel .prose-content h2,
  .prose-content h2 {
    font-size: 1.875rem !important;
    font-weight: 600 !important;
    color: #ffffff !important;
    margin-bottom: 1rem !important;
    margin-top: 2.5rem !important;
    line-height: 1.3 !important;
    font-family:
      "Poppins",
      -apple-system,
      BlinkMacSystemFont,
      "PingFang SC",
      "Microsoft YaHei",
      "Noto Sans CJK SC",
      "Source Han Sans SC",
      system-ui,
      sans-serif !important;
    display: block !important;
  }

  .glass-panel .prose-content h3,
  .prose-content h3 {
    font-size: 1.5rem !important;
    font-weight: 600 !important;
    color: #ffffff !important;
    margin-bottom: 0.75rem !important;
    margin-top: 2rem !important;
    line-height: 1.4 !important;
    font-family:
      "Poppins",
      -apple-system,
      BlinkMacSystemFont,
      "PingFang SC",
      "Microsoft YaHei",
      "Noto Sans CJK SC",
      "Source Han Sans SC",
      system-ui,
      sans-serif !important;
    display: block !important;
  }

  .glass-panel .prose-content h4,
  .prose-content h4 {
    font-size: 1.25rem !important;
    font-weight: 600 !important;
    color: #ffffff !important;
    margin-bottom: 0.5rem !important;
    margin-top: 1.5rem !important;
    line-height: 1.4 !important;
    font-family:
      "Poppins",
      -apple-system,
      BlinkMacSystemFont,
      "PingFang SC",
      "Microsoft YaHei",
      "Noto Sans CJK SC",
      "Source Han Sans SC",
      system-ui,
      sans-serif !important;
    display: block !important;
  }

  .glass-panel .prose-content p,
  .prose-content p {
    color: #d1d5db !important;
    margin-bottom: 1.25rem !important;
    line-height: 1.75 !important;
    font-size: 1.125rem !important;
    display: block !important;
  }

  .glass-panel .prose-content ul,
  .glass-panel .prose-content ol,
  .prose-content ul,
  .prose-content ol {
    color: #d1d5db !important;
    margin-bottom: 1.25rem !important;
    padding-left: 1.5rem !important;
    line-height: 1.75 !important;
