---

---

<nav class="liquid-toolbar fixed top-4 right-0 left-0 z-50">
  <div class="toolbar-shell mx-auto w-[min(1080px,calc(100%-2rem))]">
    <div class="flex h-16 items-center justify-between px-4 sm:px-6">
      <a href="/" class="brand-mark group text-slate-50">
        <img
          src="/favicon.webp"
          alt="SnowballSH logo"
          width="28"
          height="28"
          class="h-7 w-7 rounded-md object-cover"
          loading="eager"
          decoding="async"
        />
        <span class="brand-text">SnowballSH</span>
      </a>

      <div class="hidden items-center gap-2 md:flex">
        <a href="/" class="nav-link rounded-full px-4 py-2">Home</a>
        <a href="/projects" class="nav-link rounded-full px-4 py-2">Projects</a>
        <a href="/blogs" class="nav-link rounded-full px-4 py-2">Blogs</a>
        <a href="/contact" class="nav-link rounded-full px-4 py-2">Contact</a>
      </div>

      <button
        class="mobile-menu-button flex h-10 w-10 flex-col items-center justify-center space-y-1 rounded-full text-slate-50 transition-colors hover:text-cyan-100 md:hidden"
        aria-label="Toggle mobile menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
        id="mobile-menu-button"
      >
        <span
          class="menu-line block h-0.5 w-5 bg-current transition-transform duration-300"
        ></span>
        <span
          class="menu-line block h-0.5 w-5 bg-current transition-opacity duration-300"
        ></span>
        <span
          class="menu-line block h-0.5 w-5 bg-current transition-transform duration-300"
        ></span>
      </button>
    </div>

    <div
      class="mobile-menu max-h-0 overflow-hidden transition-all duration-300 md:hidden"
      id="mobile-menu"
    >
      <div class="mobile-menu-inner space-y-2 px-4 pt-1 pb-4">
        <a href="/" class="nav-link-mobile block rounded-2xl px-4 py-3">Home</a>
        <a href="/projects" class="nav-link-mobile block rounded-2xl px-4 py-3"
          >Projects</a
        >
        <a href="/blogs" class="nav-link-mobile block rounded-2xl px-4 py-3"
          >Blogs</a
        >
        <a href="/contact" class="nav-link-mobile block rounded-2xl px-4 py-3"
          >Contact</a
        >
      </div>
    </div>
  </div>
</nav>

<style>
  .toolbar-shell {
    border: 1px solid rgba(200, 237, 255, 0.38);
    background:
      linear-gradient(
        120deg,
        rgba(240, 252, 255, 0.28),
        rgba(188, 233, 255, 0.17) 35%,
        rgba(167, 221, 255, 0.18) 70%,
        rgba(230, 250, 255, 0.25)
      ),
      rgba(19, 38, 66, 0.44);
    border-radius: 999px;
    backdrop-filter: blur(24px) saturate(165%);
    box-shadow:
      0 20px 60px rgba(6, 30, 56, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.45),
      inset 0 -1px 0 rgba(178, 232, 255, 0.2);
    overflow: clip;
    position: relative;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease,
      background-color 0.25s ease;
  }

  .liquid-toolbar:hover .toolbar-shell {
    transform: translateY(-2px);
    border-color: rgba(220, 243, 255, 0.55);
    box-shadow:
      0 24px 62px rgba(6, 30, 56, 0.44),
      inset 0 1px 0 rgba(255, 255, 255, 0.5),
      inset 0 -1px 0 rgba(178, 232, 255, 0.24);
  }

  .toolbar-shell::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at 15% -60%,
        rgba(255, 255, 255, 0.8),
        transparent 55%
      ),
      radial-gradient(
        circle at 90% 130%,
        rgba(102, 207, 255, 0.2),
        transparent 55%
      );
    pointer-events: none;
  }

  .toolbar-shell::after {
    content: "";
    position: absolute;
    inset: -20%;
    transform: translateX(-65%) rotate(10deg);
    background: linear-gradient(
      to right,
      transparent,
      rgba(255, 255, 255, 0.22),
      transparent
    );
    pointer-events: none;
    animation: liquid-glint 10s ease-in-out infinite;
  }

  @keyframes liquid-glint {
    0%,
    60%,
    100% {
      transform: translateX(-65%) rotate(10deg);
      opacity: 0;
    }
    20% {
      transform: translateX(55%) rotate(10deg);
      opacity: 1;
    }
  }

  .brand-mark {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.26rem 0.76rem 0.26rem 0.28rem;
    border-radius: 999px;
    border: 1px solid rgba(179, 223, 247, 0.22);
    background: linear-gradient(
      145deg,
      rgba(9, 36, 58, 0.38),
      rgba(20, 53, 84, 0.24)
    );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.16),
      0 3px 10px rgba(8, 32, 52, 0.16);
    backdrop-filter: blur(6px) saturate(115%);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: #f4fbff;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      background-color 0.2s ease;
    isolation: isolate;
  }

  .brand-text {
    position: relative;
    z-index: 1;
    font-family:
      "Poppins",
      -apple-system,
      BlinkMacSystemFont,
      "PingFang SC",
      "Microsoft YaHei",
      "Noto Sans CJK SC",
      "Source Han Sans SC",
      system-ui,
      sans-serif;
    text-shadow:
      0 1px 0 rgba(5, 21, 34, 0.9),
      0 2px 8px rgba(5, 24, 38, 0.35);
    transition: transform 0.2s ease;
  }

  .brand-mark:hover {
    transform: translateY(-1px);
    border-color: rgba(192, 230, 250, 0.33);
    background: linear-gradient(
      145deg,
      rgba(12, 42, 66, 0.42),
      rgba(23, 59, 93, 0.28)
    );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.2),
      0 6px 14px rgba(8, 32, 52, 0.22);
  }

  .brand-mark:hover .brand-text {
    transform: translateY(-1px);
  }

  .nav-link {
    color: rgba(237, 247, 255, 0.92);
    font-weight: 550;
    position: relative;
    border: 1px solid transparent;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0);
    transition:
      color 0.25s ease,
      background-color 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: #ffffff;
    background: linear-gradient(
      140deg,
      rgba(215, 244, 255, 0.35),
      rgba(92, 198, 255, 0.26)
    );
    border-color: rgba(177, 229, 255, 0.5);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.34);
    outline: none;
  }

  .nav-link.text-primary-300 {
    color: #ffffff;
    background: linear-gradient(
      140deg,
      rgba(215, 244, 255, 0.38),
      rgba(92, 198, 255, 0.3)
    );
    border-color: rgba(177, 229, 255, 0.56);
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, #00aeef, #00d4ff);
    transition: width 0.3s ease;
  }

  .nav-link:hover::after {
    width: 100%;
  }

  .nav-link-mobile {
    color: rgba(237, 247, 255, 0.92);
    font-weight: 550;
    border: 1px solid rgba(180, 230, 255, 0.18);
    background: linear-gradient(
      145deg,
      rgba(210, 242, 255, 0.12),
      rgba(120, 196, 242, 0.08)
    );
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s ease;
    display: block;
  }

  .nav-link-mobile:hover,
  .nav-link-mobile:focus-visible {
    color: #ffffff;
    background: linear-gradient(
      145deg,
      rgba(207, 242, 255, 0.22),
      rgba(102, 207, 255, 0.2)
    );
    outline: none;
    transform: translateY(-1px);
  }

  .mobile-menu-button {
    border: 1px solid rgba(184, 232, 255, 0.2);
    background: rgba(161, 222, 255, 0.1);
  }

  .mobile-menu {
    position: relative;
    opacity: 0;
    pointer-events: none;
    transition:
      max-height 0.3s ease,
      opacity 0.2s ease;
  }

  .mobile-menu-inner {
    border-radius: 1rem;
    border: 1px solid rgba(187, 232, 255, 0.18);
    background: rgba(7, 26, 50, 0.36);
    overflow: hidden;
  }

  .toolbar-shell.menu-open .mobile-menu {
    opacity: 1;
    pointer-events: auto;
  }

  @media (max-width: 767px) {
    .liquid-toolbar {
      top: 0.75rem;
    }

    .toolbar-shell {
      border-radius: 1.1rem;
      overflow: hidden;
    }

    .toolbar-shell.menu-open {
      border-radius: 1.1rem;
      overflow: hidden;
      box-shadow:
        0 22px 56px rgba(6, 30, 56, 0.42),
        inset 0 1px 0 rgba(255, 255, 255, 0.45),
        inset 0 -1px 0 rgba(178, 232, 255, 0.2);
    }

    .brand-text {
      font-size: 0.98rem;
    }
  }

  .menu-line {
    transform-origin: center;
  }

  #mobile-menu-button.active :nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  #mobile-menu-button.active :nth-child(2) {
    opacity: 0;
  }

  #mobile-menu-button.active :nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }
</style>

<script>
  const toolbarShell = document.querySelector(".toolbar-shell");
  const mobileMenuButton = document.getElementById("mobile-menu-button");
  const mobileMenu = document.getElementById("mobile-menu");
  const mobileLinks = document.querySelectorAll(".nav-link-mobile");

  if (
    toolbarShell instanceof HTMLElement &&
    mobileMenuButton instanceof HTMLButtonElement &&
    mobileMenu instanceof HTMLElement
  ) {
    const closeMenu = () => {
      mobileMenuButton.classList.remove("active");
      mobileMenuButton.setAttribute("aria-expanded", "false");
      mobileMenu.style.maxHeight = "0";
      toolbarShell.classList.remove("menu-open");
    };

    const openMenu = () => {
      mobileMenuButton.classList.add("active");
      mobileMenuButton.setAttribute("aria-expanded", "true");
      mobileMenu.style.maxHeight = mobileMenu.scrollHeight + "px";
      toolbarShell.classList.add("menu-open");
    };

    mobileMenuButton.addEventListener("click", () => {
      const isOpen = mobileMenuButton.classList.contains("active");

      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    mobileLinks.forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Node)) {
        return;
      }

      if (!mobileMenuButton.contains(target) && !mobileMenu.contains(target)) {
        closeMenu();
      }
    });

    window.addEventListener("resize", () => {
      if (window.matchMedia("(min-width: 768px)").matches) {
        closeMenu();
      }
    });
  }

  const currentPath = window.location.pathname;
  const navLinks = document.querySelectorAll(".nav-link, .nav-link-mobile");

  navLinks.forEach((link) => {
    const href = link.getAttribute("href");
    if (href === currentPath || (currentPath === "/" && href === "/")) {
      link.classList.add("text-primary-300");
    }
  });
</script>
